#!/bin/sh

# currently can only migrate to tomorrow

if [ $# -eq 0 ]
then
    day="$(date +'%Y_%m_%d')"
else
	if [ $1 = "-h" ]
	then
		echo "Usage: bullet migrate [YYYY_MM_DD]"
		exit 0
	fi
    day=$1
fi

file="$bullet_prefix/resources/daily_log/$day"
if [ -f "$file" ]
then
	echo
	echo $file
    cat -n $file
    echo
else
    echo "$file does not exist."
    exit 1
fi

read -p "Index of item(s) to migrate: "  index
# add check to validate line

tomorrow="$(date -v+1d +'%Y_%m_%d')"
file2="$bullet_prefix/resources/daily_log/$tomorrow"
if [ ! -f "$file2" ]
then
	touch $file2
fi

sed -n "$index,$index p" $file >> $file2
sed -i '' $index"s/[o+]/>/" $file
sort -n $file > tmp && mv tmp $file
sort -n $file2 > tmp && mv tmp $file2
