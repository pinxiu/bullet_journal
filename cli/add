#!/bin/sh

if [ $# -eq 0 ]
then
    day="$(date +'%Y_%m_%d')"
else
	if [ $1 = "-h" ]
	then
		echo "Usage: bullet add [YYYY_MM_DD]"
		exit 0
	fi
    day=$1
fi

read -p "Add item: "  item

file="$bullet_prefix/resources/daily_log/$day"
if [ ! -f "$file" ]
then
	touch $file
fi

echo $item >> $file

sort -n $file > tmp && mv tmp $file
